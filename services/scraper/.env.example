# Your dashboard's own URL + draft endpoint (no auth needed, it's your own API)
DASHBOARD_API_URL=https://public-record-dashboard.onrender.com/api/cases/draft

# Same dashboard's numeric-stats endpoint (auto-fills from the above if left blank)
DASHBOARD_STATS_API_URL=https://public-record-dashboard.onrender.com/api/stats

# Free API key from https://data.gov.in/user/register -> "My Account" -> "API Keys"
DATA_GOV_API_KEY=

# Resource ID for the "Environmental Clearance Granted - Parivesh 2.0" dataset on data.gov.in
# Find it on the dataset's page -> "API" tab -> copy the resource_id from the sample URL
DATA_GOV_RESOURCE_ID=

# Optional — a data.gov.in resource_id for a fund-utilization dataset of your choice
# (e.g. search data.gov.in for "CAMPA" or "MGNREGA fund release"). Leave blank to skip.
FUND_DATASET_RESOURCE_ID=
